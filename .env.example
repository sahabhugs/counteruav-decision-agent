# ============================================================
# 反无人机决策Agent系统 - 环境变量配置模板
# 复制此文件为 .env 并修改实际值
#   cp .env.example .env
# ============================================================

# ---- 数据库配置 ----
MYSQL_ROOT_PASSWORD=ChangeMe@2026
MYSQL_PASSWORD=ChangeMe_decision_2026

# ---- LLM Agent 配置 ----
# 模型文件路径 (容器内路径)
LLM_MODEL_PATH=/app/models/qwen3-8b-q4_k_m.gguf
LLM_EMBEDDING_MODEL=/app/models/bge-small-zh

# 推理参数
LLM_N_CTX=8192
LLM_N_THREADS=8
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Agent 参数
LLM_MAX_ROUNDS=5
LLM_TIMEOUT_SECONDS=10

# ---- 决策参数 ----
CONFIDENCE_THRESHOLD=0.80
MAX_CALLS_PER_MINUTE=10
COOLDOWN_SECONDS=5
MAX_CALLS_PER_TARGET=3

# ---- GPU 支持 (可选) ----
# 取消注释以启用GPU加速
# CUDA_VISIBLE_DEVICES=0

# ---- 日志级别 ----
LOG_LEVEL=INFO
# LOG_LEVEL=DEBUG  # 调试时使用

# ---- JVM 参数 ----
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
